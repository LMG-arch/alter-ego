# ─────────────────────────────────────────────────────────────
# AlterEgo · 拟我 —— 拟人化生活模拟 Agent
# ─────────────────────────────────────────────────────────────

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# ── 虚拟环境 ──
.venv/
venv/
env/
ENV/
.python-version

# ── 测试与覆盖率 ──
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# ── 类型检查与缓存 ──
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/

# ── 打包与工具 ──
.uv/
.uv-cache/
poetry.lock.bak
Pipfile.lock

# ═════════════════════════════════════════════════════════════
# ⚠️ 运行时数据：这些绝不能提交
# ═════════════════════════════════════════════════════════════

# ── 数据库与备份 ──
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
data/outbox/
data/cache/

# ── 个人数据 ──
# 生日记录是用户自己的数据，绝不能进版本库：提交一次就等于把它钉在历史里，
# 之后删掉也还在。注意 `data/` 目录本身**没有**被整体忽略
# （`data/plugins/`、`data/.gitkeep` 是要提交的），所以这里必须点名这个文件。
data/birthdays.toml
*.sqlite
*.sqlite3

# ── 日志 ──
# 写成 `logs/*` 而不是 `logs/`：整体排除目录的话 git 根本不会进去看，
# 后面的 `!logs/.gitkeep` 就永远不会生效。
logs/*
!logs/.gitkeep
*.log
*.log.*

# ── 密钥与令牌 ──
.env
.env.*
!.env.example
.alterego-token
secrets/
*.pem
*.key
credentials.json

# ── 本地配置覆盖 ──
config/alterego.local.toml
config/*.local.toml
alterego.local.toml

# ── 用户数据（人格实例、记忆、导出）──
instances/*
!instances/.gitkeep
persona.local.toml
exports/*
!exports/.gitkeep
*.export.json
*.export.jsonl

