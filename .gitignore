.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/*.code-snippets

# ── JetBrains ──
.idea/
*.iml
*.iws
*.ipr
out/

# ── Vim ──
*.swp
*.swo
*~
tags
.vim/

# ── macOS ──
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Windows ──
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Linux ──
*~
.fuse_hidden*
.directory
.Trash-*

# ═════════════════════════════════════════════════════════════
# 插件与临时文件
# ═════════════════════════════════════════════════════════════

# 本地开发的插件（不应提交到主仓库）
plugins/*/
!plugins/.gitkeep
!plugins/README.md
!plugins/tokenizer_jieba/
!plugins/example_*/

# 临时文件
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*.pid
*.seed

# 生成的前端产物（本项目无构建步骤，但保留规则以防万一）
src/alterego/channels/web/static/*.min.js
src/alterego/channels/web/static/*.min.css
